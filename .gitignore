# Secrets — never commit
.env
.env.*
*.key
*.pem
credentials.json
*credentials*.json
secrets/

# n8n database and runtime state
*.sqlite
*.sqlite-shm
*.sqlite-wal
.n8n/

# Local backups (may contain unredacted exports)
backups/*
!backups/.gitkeep

# Raw exports before redaction — stage into workflows/ only after scan-secrets.sh passes
*.raw.json
/tmp/

# OS and editor
.DS_Store
.vscode/
.idea/
*.swp

# Python
__pycache__/
*.pyc
venv/
.venv/

# Node
node_modules/
npm-debug.log*

# Business work product: stays local, never pushed
pursuits/
leads/
policies/
capability/

# Consolidated business folders (moved in 2026-09-16 reorg)
# sam-hunter is its own git repo, never nest it in this one
sam-hunter/
n8n-backups/
omegacortex-data/
